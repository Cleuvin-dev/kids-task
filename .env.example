# Variáveis de ambiente do Kid's Task — modelo, sem valores reais.
#
# Nada neste arquivo é secreto: contém apenas URL de projeto, chave
# publicável e identificadores públicos. `service_role`, credenciais de FCM,
# APNs e das lojas NUNCA entram aqui nem no app — ficam em
# `supabase secrets set` (Edge Functions) e nos secrets do CI/CD.
# Ver docs/08_ARQUITETURA_TECNICA.md seção 12 e docs/10_...LGPD.md seção 8.
#
# Cada ambiente (dev, staging, prod) tem seu próprio projeto Supabase e
# Firebase, com estas mesmas chaves preenchidas com valores próprios. Os apps
# Flutter leem estes valores em tempo de build via:
#
#   flutter run --dart-define-from-file=env/dev.json
#   flutter build web --dart-define-from-file=env/prod.json
#
# `env/<ambiente>.json` é o mesmo conjunto de chaves abaixo em formato JSON e
# NÃO deve ser commitado (já ignorado em .gitignore); apenas este .env.example
# documenta quais chaves existem.

# --- Supabase (apps/mobile e apps/admin_web) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Firebase Cloud Messaging (apps/mobile) ---
# google-services.json (Android) e GoogleService-Info.plist (iOS) não são
# variáveis de texto: seguem como arquivos de plataforma, fora do controle de
# versão, um por ambiente. FIREBASE_PROJECT_ID aqui é só para os scripts de
# build/CI selecionarem o arquivo correto.
FIREBASE_PROJECT_ID=<firebase-project-id>

# --- Compras nas lojas (apps/mobile) ---
# IDs de produto por ambiente; nunca fixar preço no código (docs/13, seção 2).
STORE_PREMIUM_MONTHLY_PRODUCT_ID=kids_task_premium_monthly
STORE_PREMIUM_YEARLY_PRODUCT_ID=kids_task_premium_yearly

# --- Painel administrativo Web (apps/admin_web) ---
# Mesmo projeto Supabase do ambiente, mas o login de platform_admin exige MFA
# e é resolvido inteiramente no backend; nenhuma chave adicional é necessária
# aqui além de SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY acima.

# --- Somente backend (Supabase secrets / CI, nunca em .env do app) ---
# SUPABASE_SERVICE_ROLE_KEY=
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APPLE_SHARED_SECRET=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# TRANSACTIONAL_EMAIL_API_KEY=
